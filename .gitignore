# Server data — generated at runtime, never commit
csprng_seed.txt
PADatabase.sqlite3
players.txt
leaderboard.csv
GameResults.csv
ftp/
reports/
placement_matches/

# OS / editor
.DS_Store
Thumbs.db
*.swp
logs/

# Pre-deploy snapshots from gather_logs.sh — keep local for post-mortems
gathered_logs/

# Crash reports — captured server-side, see docs/CRASH_REPLAY_PLAN.md
crash_reports/
# Per-test rootDir scratch space for CrashReportsTests.lua isolation
crash_reports_test/

# Always-on JSONL traces (client local + server tap)
trace_archive/
trace_archive_test/

# lua-language-server check output (regenerated by run_lua_check.sh)
.luals-check/

# Claude Code local state (settings.local.json, scheduled task locks)
.claude/
.aider*

# Updater shell: the embedded offline-base game .love is regenerated at
# shell-build time (build-shells.sh / build-shells.yml), never committed (~48MB).
updater-shell/team/*/game.love
# love-build output for the shells
dev-build-shells/

# Updater shell: lua-https native libs are produced by build-shells.yml (CI) and
# fetched at package time. macOS must be universal (lipo arm64+x86_64), so don't
# commit locally-built single-arch binaries.
updater-shell/https/**/*.so
updater-shell/https/**/*.dll
